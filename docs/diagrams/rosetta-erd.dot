digraph rosetta_erd {
  graph [rankdir=BT, splines=ortho, newrank=true, nodesep=0.6, ranksep=0.8,
         fontname="Helvetica", pad=0.3];
  node [shape=plaintext, fontname="Helvetica"];
  edge [dir=both, arrowtail=crow, arrowhead=tee, color="#334155", penwidth=1.1];
  subgraph cluster_people {
    label=<<B>People, roles and settings</B>>; style="dashed,rounded"; color="#1d4ed8"; fontcolor="#1d4ed8"; fontsize=14;
    person [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#eff6ff"><B>person</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR></TABLE>>];
    role_grant [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#eff6ff"><B>role_grant</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">person_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">granted_by</FONT></TD></TR></TABLE>>];
    setting [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#eff6ff"><B>setting</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">updated_by</FONT></TD></TR></TABLE>>];
    change_history [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#eff6ff"><B>change_history</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">changed_by</FONT></TD></TR></TABLE>>];
    paradox_run [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#eff6ff"><B>paradox_run</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">run_id</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_callers {
    label=<<B>Callers and keys</B>>; style="dashed,rounded"; color="#b45309"; fontcolor="#b45309"; fontsize=14;
    caller [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b45309" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#fffbeb"><B>caller</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">registered_by</FONT></TD></TR></TABLE>>];
    caller_key [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b45309" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#fffbeb"><B>caller_key</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">caller_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">created_by</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">turned_off_by</FONT></TD></TR></TABLE>>];
    caller_origin [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b45309" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#fffbeb"><B>caller_origin</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">caller_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">origin</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">added_by</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_sources {
    label=<<B>Sources and gate</B>>; style="dashed,rounded"; color="#047857"; fontcolor="#047857"; fontsize=14;
    source [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#047857" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#ecfdf5"><B>source</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">switched_by</FONT></TD></TR></TABLE>>];
    source_offer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#047857" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#ecfdf5"><B>source_offer</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">source_id</FONT></TD></TR></TABLE>>];
    source_order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#047857" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#ecfdf5"><B>source_order</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">operation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">from_language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">to_language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">position</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">source_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">set_by</FONT></TD></TR></TABLE>>];
    gate_decision [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#047857" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#ecfdf5"><B>gate_decision</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">source_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">decided_by</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_glossary {
    label=<<B>Glossary</B>>; style="dashed,rounded"; color="#6d28d9"; fontcolor="#6d28d9"; fontsize=14;
    glossary_entry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6d28d9" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f5f3ff"><B>glossary_entry</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">replaces_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">glossary_import_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">published_in</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">proposed_by</FONT></TD></TR></TABLE>>];
    glossary_term [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6d28d9" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f5f3ff"><B>glossary_term</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">glossary_entry_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">checked_by</FONT></TD></TR></TABLE>>];
    glossary_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6d28d9" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f5f3ff"><B>glossary_version</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">published_by</FONT></TD></TR></TABLE>>];
    glossary_import [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6d28d9" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f5f3ff"><B>glossary_import</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">imported_by</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_memory {
    label=<<B>Memory and cache</B>>; style="dashed,rounded"; color="#0f766e"; fontcolor="#0f766e"; fontsize=14;
    memory_entry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f766e" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f0fdfa"><B>memory_entry</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">caller_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">glossary_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">replaced_by_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">reviewed_by</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">removed_by</FONT></TD></TR></TABLE>>];
    cache_piece [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f766e" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f0fdfa"><B>cache_piece</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">source_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">from_language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">to_language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">source_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">glossary_version</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_records {
    label=<<B>Records and alerts</B>>; style="dashed,rounded"; color="#475569"; fontcolor="#475569"; fontsize=14;
    usage_record [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#475569" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f8fafc"><B>usage_record</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">caller_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">person_id</FONT></TD></TR></TABLE>>];
    daily_total [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#475569" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f8fafc"><B>daily_total</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">day</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">caller_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">operation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">from_language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">to_language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">outcome</FONT></TD></TR></TABLE>>];
    audit_outbox [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#475569" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f8fafc"><B>audit_outbox</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">actor_id</FONT></TD></TR></TABLE>>];
    alert [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#475569" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f8fafc"><B>alert</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">caller_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">source_id</FONT></TD></TR></TABLE>>];
  }
  { rank=min; person; caller; source; }
  { rank=same; setting; paradox_run; }
  glossary_version -> memory_entry [style=invis];
  glossary_import -> cache_piece [style=invis];
  setting -> role_grant [style=invis];
  paradox_run -> change_history [style=invis];
  role_grant -> person [];
  change_history -> person [];
  audit_outbox -> person [style=dashed];
  caller_key -> caller [];
  caller_origin -> caller [];
  source_offer -> source [];
  source_order -> source [];
  gate_decision -> source [];
  glossary_entry -> glossary_entry [style=dashed];
  glossary_entry -> glossary_import [style=dashed];
  glossary_entry -> glossary_version [style=dashed];
  glossary_term -> glossary_entry [];
  memory_entry -> caller [];
  memory_entry -> glossary_version [];
  memory_entry -> memory_entry [style=dashed];
  cache_piece -> source [];
  cache_piece -> glossary_version [];
  usage_record -> caller [];
  daily_total -> caller [];
  alert -> caller [style=dashed];
  alert -> source [style=dashed];
}
