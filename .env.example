# ROSETTA settings. Copy to .env for local work; .env is never committed.
# Real secrets are set by the Office on the server only.
# Values below work with the local stack: docker compose -f dev/compose.yaml up -d postgres pgbouncer

# Where ROSETTA listens (default :8080, as the platform's Caddy expects).
ROSETTA_LISTEN=:53080

# ROSETTA's database through PgBouncer in transaction mode (pool 5).
DATABASE_URL=postgres://rosetta:rosetta@localhost:53432/rosetta

# The same database through the session-mode entry (pool 1), read only by `rosetta migrate`.
MIGRATE_DATABASE_URL=postgres://rosetta:rosetta@localhost:53432/rosetta_session

# PARADOX's public key, which every job call is checked against; two,
# comma-separated, while it is being changed. Locally: run dev/keys.sh, then copy
# the line from dev/keys/paradox.env. On the server: the platform's key.
PARADOX_PUBLIC_KEY=

# Addresses and keys of the services ROSETTA calls: stand-ins locally, the real
# services at Go live (E-ENB-03). Go live changes these settings, not code. The
# keys below are the stand-ins' own; real keys are set on the server only.
# Run the stand-ins: go run ./cmd/rosetta-standin (control address: /control).
ROSETTA_BUMBLEBEE_URL=http://localhost:53190/bumblebee
ROSETTA_BUMBLEBEE_KEY=bb_standin
ROSETTA_BIFROST_URL=http://localhost:53190/bifrost
ROSETTA_BIFROST_KEY=bf_standin
ROSETTA_PENSIEVE_URL=http://localhost:53190/pensieve
ROSETTA_PENSIEVE_KEY=pv_standin
ROSETTA_HEDWIG_URL=http://localhost:53190/hedwig
ROSETTA_HEDWIG_KEY=hw_test_standin

# The folder holding TVA's systems.json. On the server it comes from SeaweedFS
# with a read-only key (E-ENB-11).
ROSETTA_TVA_DIR=dev/tva

# The address people reach the screens on. https, except on this machine for local
# work; the session cookie is Secure unless this is plain http on this machine.
ROSETTA_PUBLIC_URL=http://localhost:53080

# Sign-in through MJOLNIR (OpenID Connect, client_secret_basic). The issuer is
# compared exactly as MJOLNIR publishes it. ROSETTA_SIGNIN_INTERNAL_URL is where
# ROSETTA itself reaches MJOLNIR, when that differs from the issuer (B 8).
ROSETTA_SIGNIN_ISSUER=http://localhost:53190/mjolnir
ROSETTA_SIGNIN_INTERNAL_URL=
ROSETTA_SIGNIN_CLIENT_ID=rosetta
ROSETTA_SIGNIN_CLIENT_SECRET=local-stand-in-only

# The MJOLNIR account that becomes the first administrator at its next sign-in.
# It works only while no administrator exists; it does nothing after that.
ROSETTA_FIRST_ADMIN=dev-admin
