# rosetta.env on the server only; mode 600, owner root. Never in git.
# ROSETTA will not start with any of the first three groups missing. The keys under "Later"
# need ROSETTA's TVA entry, so it starts without them and says at each start what waits.

# Through PgBouncer in transaction mode, pool 5.
DATABASE_URL=postgres://rosetta:<password>@pgbouncer:6432/rosetta?pool_max_conns=5

# PARADOX's public key; two, comma separated, while it is changed.
PARADOX_PUBLIC_KEY=<key>

# Signing in through MJOLNIR. The issuer ends in a slash, exactly: tokens are compared whole.
# Client: id rosetta, client_secret_basic, grants authorization_code and refresh_token, scopes
# openid offline_access email profile (redirect https://rosetta.epc.lk/signin/callback).
ROSETTA_PUBLIC_URL=https://rosetta.epc.lk
ROSETTA_SIGNIN_ISSUER=https://sso.epc.lk/
ROSETTA_SIGNIN_CLIENT_ID=rosetta
ROSETTA_SIGNIN_CLIENT_SECRET=<secret>
ROSETTA_SIGNOUT_URL=https://id.epc.lk/sign-out

# The first administrator's email at MJOLNIR, or their account ID. Used only while ROSETTA has
# no administrator.
ROSETTA_FIRST_ADMIN=<email>

# TVA's lookup bucket, with ROSETTA's own key, which reads systems.json and nothing else. Read
# when a system is registered and in the job daily, so ROSETTA starts before the file exists.
ROSETTA_TVA_S3_ENDPOINT=http://caddy:8333
ROSETTA_TVA_S3_KEY=<key>
ROSETTA_TVA_S3_SECRET=<secret>

# Later. Addresses as each service's own documents give them; each key is set when issued, and
# the container recreated.
# Empty: audit entries wait in the outbox, up to 30 days.
ROSETTA_PENSIEVE_URL=http://pensieve:8080
ROSETTA_PENSIEVE_KEY=
# Empty: the source list cannot be read, and every direction answers no provider.
ROSETTA_BUMBLEBEE_URL=http://bumblebee:8080
ROSETTA_BUMBLEBEE_KEY=
# Empty: every post look-up fails and changes nothing, so no role ends on it.
ROSETTA_BIFROST_URL=http://caddy:8100
ROSETTA_BIFROST_KEY=
# Unset: notices wait in the database. Set the address and the key together.
# ROSETTA_HEDWIG_URL=http://hedwig:8080
# ROSETTA_HEDWIG_KEY=<key>
